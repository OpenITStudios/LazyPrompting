{
  "manifest_version": 3,
  "name": "LazyPrompting Companion",
  "version": "0.1.0",
  "description": "Inline context meter, settings and user-initiated New Chat navigation; old chats stay for reviewed manual cleanup.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "companion/core.js",
        "companion/compact-history.js",
        "companion/history-visibility.js",
        "companion/limit-notice.js",
        "companion/usage-meter-signal.js",
        "companion/settings.js",
        "companion/new-chat.js",
        "companion/status-resolver.js",
        "companion/toolbar.js"
      ],
      "css": [
        "companion/toolbar.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
