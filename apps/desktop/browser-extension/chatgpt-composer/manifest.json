{
  "manifest_version": 3,
  "name": "LazyPrompting Companion",
  "version": "0.1.0",
  "description": "Compact ChatGPT turn navigation and operator-authored notes, selective copy and manual source review. Native app owns chat recovery.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "companion/core.js",
        "companion/toolbar.js"
      ],
      "css": [
        "companion/toolbar.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
