{
  "manifest_version": 3,
  "name": "LazyPrompting Companion",
  "version": "0.1.0",
  "description": "Lightweight ChatGPT navigation, optional per-chat compact rendering, operator notes and manual source review; native host owns recovery.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "companion/core.js",
        "companion/compact-history.js",
        "companion/limit-notice.js",
        "companion/toolbar.js"
      ],
      "css": [
        "companion/toolbar.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
