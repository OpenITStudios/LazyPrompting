{
  "name": "@openitstudios/lazyprompting-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev:app": "tauri dev",
    "build:app": "tauri build",
    "test:work-admission": "node --test src/app/work-admission.test.mjs",
    "test:webview-status": "node --test src/app/webview-status.test.mjs",
    "test:view-coordinator": "node --test src/app/view-coordinator.test.mjs",
    "test:embedded-view-bridge": "node --test src/app/embedded-view-bridge.test.mjs",
    "test:viewer-queue": "node --test src/app/viewer-queue.test.mjs",
    "test:lightpanda-host": "node --test src/app/lightpanda-host.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}
