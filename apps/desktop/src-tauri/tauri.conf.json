{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LazyPrompting",
  "version": "0.1.0",
  "identifier": "com.openitstudios.lazyprompting",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1425",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LazyPrompting",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:1425"
    }
  },
  "bundle": {
    "active": false
  }
}
